NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://resortpro:resortpro_dev@localhost:5432/resortpro

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@resortpro.com

# Super Admin (comma-separated emails that get super admin access)
SUPER_ADMIN_EMAILS=your@email.com

# Stripe (test mode — get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Plan Price IDs (create in Stripe Dashboard > Products)
# Test mode price IDs look like: price_1ABC...
STRIPE_PRICE_STARTER=price_your_starter_monthly_price_id
STRIPE_PRICE_PRO=price_your_pro_monthly_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_monthly_price_id

# Web app URL (used in Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# App URL
APP_URL=http://localhost:4000

# ── File Storage (Cloudflare R2 or AWS S3) ────────────────────────────────────
# Cloudflare R2 setup:
#   1. Go to Cloudflare Dashboard → R2 → Create bucket
#   2. Create an API token with R2 read+write permissions
#   3. Enable "Public access" on the bucket (or use a custom domain)
#   STORAGE_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_REGION   = auto
#
# AWS S3 setup:
#   Leave STORAGE_ENDPOINT empty. Set region to your bucket's region.
#   Make sure the bucket policy allows public read (or use CloudFront).
#
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id
STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key
STORAGE_BUCKET=resortpro-uploads
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
