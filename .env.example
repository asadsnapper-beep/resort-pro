# ─────────────────────────────────────────────────────────────────────────────
# ResortPro — Environment Variables
# Copy to .env.production and fill in your values.
# In Coolify: paste these into the "Environment Variables" section.
# ─────────────────────────────────────────────────────────────────────────────

# ── URLs (set these first) ───────────────────────────────────────────────────
# Public URL of your API — used as NEXT_PUBLIC_API_URL (baked into JS bundle at build time!)
API_URL=https://api.yourdomain.com

# Public URL of your web app
WEB_URL=https://app.yourdomain.com

# Domains for Traefik routing (docker-compose.coolify.yml)
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com

# Your platform's root domain (used for custom domain CNAME instructions)
APP_DOMAIN=yourdomain.com

# Server's public IP (optional — for A-record custom domain verification)
APP_IP=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=resortpro
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=resortpro

# Auto-built from above in docker-compose — override only if using external DB:
# DATABASE_URL=postgresql://resortpro:password@host:5432/resortpro

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_64_byte_random_hex_string_here
JWT_EXPIRES_IN=7d

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# IMPORTANT: verify your sending domain (resortpro.site) in Resend first
# (add SPF + DKIM DNS records) or delivery will fail / land in spam.
# Without RESEND_API_KEY set, outgoing emails are safely disabled (skipped).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# FROM address — must be on a domain verified in Resend.
EMAIL_FROM=ResortPro <noreply@resortpro.site>

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxx

# ── Super Admin ───────────────────────────────────────────────────────────────
# Comma-separated list of super admin email addresses
SUPER_ADMIN_EMAILS=admin@yourdomain.com
