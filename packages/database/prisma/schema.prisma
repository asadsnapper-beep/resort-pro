// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id             String          @id @default(uuid())
  tenantId       String
  userId         String          @unique
  department     StaffDepartment @default(FRONT_DESK)
  position       String
  phone          String?
  hireDate       DateTime        @db.Date
  isActive       Boolean         @default(true)
  shiftStartTime String? // "09:00" — used to compute LATE on clock-in
  baseSalary     Float?
  deviceUserId   String? // ID configured on the fingerprint device for this staff member
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
