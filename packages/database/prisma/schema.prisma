  source      String   @default("MANUAL") // MANUAL | DEVICE_IMPORT | DEVICE_WEBHOOK
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
