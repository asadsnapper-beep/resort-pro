// Guest chatbot session — abuse/cost control (memory-only conversation).
model GuestChatSession {
  id        String   @id @default(uuid())
  tenantId  String
  sessionId String   @unique // client-generated UUID
  turnCount Int      @default(0)
  ipHash    String // SHA-256 of IP — never plain IP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("guest_chat_sessions")
}

// Flagged prompt-injection / abuse attempts (audit trail).
model AiAbuse {
  id         String   @id @default(uuid())
  tenantId   String
  sessionId  String
  ipHash     String
  flaggedMsg String // trimmed to 500 chars
  reason     String
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_abuse")
}

// Daily/weekly revenue snapshot powering business suggestions.
model RevenueSnapshot {
  id             String   @id @default(uuid())
  tenantId       String
  snapshotDate   DateTime
  period         String // daily | weekly | monthly
  totalRooms     Int
  availableRooms Int
  roomsSold      Int
  occupancyRate  Float
  adr            Float
  revpar         Float
  roomRevenue    Float
  fbRevenue      Float?
  totalRevenue   Float
  cancellations  Int      @default(0)
  bySource       Json?
  byRoomType     Json?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate, period])
  @@index([tenantId])
  @@map("revenue_snapshots")
}

// AI-generated business insight / suggestion (proposal — owner acts).
model AIInsight {
  id        String   @id @default(uuid())
  tenantId  String
  kind      String // briefing | anomaly | suggestion
  title     String
  body      String
  severity  String   @default("info") // info | warning | critical
  status    String   @default("new") // new | seen | dismissed | actioned
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_insights")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  category     InventoryCategory @default(OTHER)
  unit         String
  currentStock Decimal           @db.Decimal(10, 2)
  minimumStock Decimal           @db.Decimal(10, 2)
  unitCost     Decimal           @db.Decimal(10, 2)
  supplier     String?
  vendorId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor           Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  movements        InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([tenantId])
  @@index([vendorId])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String   @id @default(uuid())
  tenantId        String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(10, 2)
  type            String // IN | OUT | ADJUSTMENT
  reason          String?
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("inventory_movements")
}

model Vendor {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
  assets         Asset[]

  @@index([tenantId])
  @@map("vendors")
}

model PurchaseOrder {
  id         String    @id @default(uuid())
  tenantId   String
  vendorId   String
  poNumber   String    @unique
  status     String    @default("DRAFT") // DRAFT | SENT | RECEIVED | CANCELLED
  notes      String?
  sentAt     DateTime?
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items  PurchaseOrderItem[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantityOrdered  Float
  quantityReceived Float  @default(0)
  unitCost         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum AssetCategory {
  FURNITURE
  ELECTRONICS
  APPLIANCE
  KITCHEN_EQUIPMENT
  VEHICLE
  IT_EQUIPMENT
  OTHER
}

enum AssetStatus {
  IN_USE
  IN_REPAIR
  IN_STORAGE
  RETIRED
}

model Asset {
  id                String        @id @default(uuid())
  tenantId          String
  assetTag          String        @unique
  name              String
  category          AssetCategory @default(OTHER)
  status            AssetStatus   @default(IN_USE)
  condition         String        @default("GOOD") // GOOD | FAIR | POOR
  locationRoomId    String?
  locationLabel     String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  warrantyExpiresAt DateTime?
  vendorId          String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationRoom    Room?                 @relation(fields: [locationRoomId], references: [id], onDelete: SetNull)
  vendor          Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  maintenanceLogs AssetMaintenanceLog[]

  @@index([tenantId])
  @@index([locationRoomId])
  @@index([vendorId])
  @@map("assets")
}

model AssetMaintenanceLog {
  id          String   @id @default(uuid())
  assetId     String
  type        String // SERVICE | REPAIR | INSPECTION
  cost        Float?
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_maintenance_logs")
}

// ─── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id             String         @id @default(uuid())
  tenantId       String
  guestId        String?
  assignedToId   String?
  bookingId      String?
  title          String
  description    String
  category       TicketCategory @default(OTHER)
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  source         String         @default("WEB") // "WEB" | "WHATSAPP" | "TELEGRAM"
  externalChatId String? // telegram chat_id or WA phone number (for reply routing)
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest      Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([tenantId])
  @@index([status])
  @@index([source])
  @@map("support_tickets")
}

model ChatMessage {
  id            String         @id @default(uuid())
  ticketId      String
  senderId      String
  senderType    ChatSenderType
  message       String
  isRead        Boolean        @default(false)
  externalMsgId String? // Telegram message_id or WA message_id (dedup)
  createdAt     DateTime       @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("chat_messages")
}

// ─── Website ──────────────────────────────────────────────────────────────────

model WebsiteContent {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  heroTitle         String
  heroSubtitle      String?
  heroImage         String?
  aboutTitle        String?
  aboutText         String?
  aboutImage        String?
  galleryImages     String[]
  testimonials      Json     @default("[]")
  seoTitle          String?
  seoDescription    String?
  primaryColor      String   @default("#1a6b5e")
  accentColor       String   @default("#d4a853")
  templateId        String   @default("luxe")
  // Social media links
  facebookUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  tiktokUrl         String?
  youtubeUrl        String?
  whatsappNumber    String? // phone number only e.g. "+8801XXXXXXXXX"
  tripadvisorUrl    String?
  hiddenSections    String[] @default([]) // sections owner has toggled off e.g. ["menu","gallery"]
  sectionOrder      String[] @default([]) // owner's custom section order; empty = theme default
  googleAnalyticsId String? // GA4 Measurement ID e.g. "G-XXXXXXXXXX"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("website_content")
}

model WebsitePageView {
  id       String   @id @default(cuid())
  tenantId String
  date     DateTime @db.Date
  count    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("website_page_views")
}

// ── Daily Report Auto-Dispatch settings (Telegram + WhatsApp) ─────────────────
model ReportDispatchSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // Master toggle
  enabled      Boolean @default(false)
  dispatchTime String  @default("22:00") // "HH:MM" in tenant's local time

  // Telegram
  telegramEnabled  Boolean @default(false)
  telegramBotToken String? // kept encrypted at rest in production
  telegramChatId   String? // numeric chat/channel ID

  // WhatsApp — phone number to send report to (owner's WA number)
  whatsappEnabled Boolean @default(false)
  whatsappPhone   String? // e.g. "+8801XXXXXXXXX"

  // Last dispatch tracking
  lastDispatchedAt DateTime?
  lastDispatchDate String? // "YYYY-MM-DD" of last report sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("report_dispatch_settings")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

enum GuestTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum EmailSendStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SequenceTrigger {
  BOOKING_CONFIRMED
  PRE_ARRIVAL
  CHECK_IN
  POST_STAY
  WIN_BACK
  BIRTHDAY
  ANNIVERSARY
  MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  UNSUBSCRIBED
}

enum ActivityType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  CHECK_IN
  CHECK_OUT
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  FOOD_ORDER
  SUPPORT_TICKET
  FEEDBACK_SUBMITTED
}

// Guest tags (e.g. "VIP", "Honeymoon", "Corporate")
model GuestTag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relations GuestTagRelation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("guest_tags")
}

model GuestTagRelation {
  id        String   @id @default(uuid())
  guestId   String
  tagId     String
  createdAt DateTime @default(now())

  guest Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tag   GuestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([guestId, tagId])
  @@map("guest_tag_relations")
}

// Guest loyalty score + tier
model GuestScore {
  id          String    @id @default(uuid())
  tenantId    String
  guestId     String    @unique
  score       Int       @default(0)
  tier        GuestTier @default(STANDARD)
  totalStays  Int       @default(0)
  totalSpend  Decimal   @default(0) @db.Decimal(12, 2)
  emailOpens  Int       @default(0)
  emailClicks Int       @default(0)
  lastStayAt  DateTime?
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([score])
  @@map("guest_scores")
}

// Email consent / unsubscribe
model EmailConsent {
  id             String    @id @default(uuid())
  tenantId       String
  guestId        String    @unique
  subscribed     Boolean   @default(true)
  unsubscribedAt DateTime?
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_consents")
}

// Activity log for guests
model GuestActivity {
  id        String       @id @default(uuid())
  tenantId  String
  guestId   String
  type      ActivityType
  meta      Json?
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([guestId])
  @@map("guest_activities")
}

// Reusable email templates with HTML content
model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  subject   String
  html      String
  preheader String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  steps     SequenceStep[]

  @@index([tenantId])
  @@map("email_templates")
}

// Broadcast campaigns (one-time email blasts)
model Campaign {
  id             String         @id @default(uuid())
  tenantId       String
  templateId     String?
  name           String
  subject        String
  html           String
  segment        Json? // filter criteria (tier, tags, lastStayBefore, etc.)
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sends    EmailSend[]
  stats    CampaignStats?

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

// Aggregate stats per campaign
model CampaignStats {
  id           String   @id @default(uuid())
  campaignId   String   @unique
  sent         Int      @default(0)
  delivered    Int      @default(0)
  opened       Int      @default(0)
  clicked      Int      @default(0)
  bounced      Int      @default(0)
  unsubscribed Int      @default(0)
  updatedAt    DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_stats")
}

// Individual email send record (per guest per campaign/sequence)
model EmailSend {
  id             String          @id @default(uuid())
  tenantId       String
  guestId        String
  campaignId     String?
  sequenceStepId String?
  enrollmentId   String?
  subject        String
  status         EmailSendStatus @default(PENDING)
  resendId       String? // Resend message ID
  openedAt       DateTime?
  deliveredAt    DateTime?
  bouncedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  clicks       EmailClick[]

  @@index([tenantId])
  @@index([guestId])
  @@index([campaignId])
  @@map("email_sends")
}

// Link click tracking
model EmailClick {
  id        String   @id @default(uuid())
  sendId    String
  url       String
  clickedAt DateTime @default(now())

  send EmailSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@index([sendId])
  @@map("email_clicks")
}

// ─── Stripe ───────────────────────────────────────────────────────────────────

model StripeWebhookEvent {
  id        String   @id @default(uuid())
  stripeId  String   @unique
  type      String
  processed Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())

  @@index([type])
  @@map("stripe_webhook_events")
}

// Singleton platform-level settings (one row)
model PlatformSettings {
  id              String   @id @default("singleton")
  trialDays       Int      @default(14)
  plans           Json // Array of { key, name, price, features, roomLimit }
  storageConfig   Json? // { driver, endpoint, region, bucket, publicUrl, accessKey, secretKey }
  aiApiKey        String? // Encrypted API key for AI theme generation (Claude/GPT)
  aiProvider      String? // "claude" | "gpt-4" — default provider
  aiEnabledGlobal Boolean  @default(false) // Master switch — all AI features off until super-admin flips this. See plan/ai/ROLLOUT-STRATEGY.md
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}

// Automated email sequences (drip campaigns)
model Sequence {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  trigger     SequenceTrigger
  triggerMeta Json? // e.g. { daysOffset: -3 } for pre-arrival
  status      SequenceStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@index([trigger])
  @@map("sequences")
}

// Individual steps inside a sequence (each = one email)
model SequenceStep {
  id         String   @id @default(uuid())
  sequenceId String
  templateId String?
  stepOrder  Int
  delayDays  Int      @default(0) // days after trigger
  subject    String
  html       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sequence Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sends    EmailSend[]

  @@index([sequenceId])
  @@map("sequence_steps")
}

// Tracks which guests are enrolled in which sequences
model SequenceEnrollment {
  id          String           @id @default(uuid())
  tenantId    String
  sequenceId  String
  guestId     String
  status      EnrollmentStatus @default(ACTIVE)
  currentStep Int              @default(0)
  triggerMeta Json? // context at time of enrollment (bookingId, checkIn, etc.)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, guestId])
  @@index([tenantId])
  @@index([status])
  @@map("sequence_enrollments")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── Admin Notifications ──────────────────────────────────────────────────────

model AdminNotification {
  id        String   @id @default(cuid())
  type      String // new_signup | payment_failed | subscription_canceled | trial_expiring | account_suspended
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json? // { tenantId, tenantName, tenantSlug, plan, amount, ... }
  linkPath  String? // e.g. "/admin/tenants?id=xxx" — click → navigate here
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // impersonate | suspend | reactivate | plan_change | extend_trial | export | settings_change | theme_update | theme_toggle
  targetType String // tenant | user | theme | settings
  targetId   String?
  targetName String? // human-readable label (tenant name, theme key, etc.)
  metadata   Json? // { before, after } for plan_change; { days } for extend_trial; etc.
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Platform Announcements ───────────────────────────────────────────────────

model PlatformAnnouncement {
  id            String    @id @default(cuid())
  title         String
  body          String // markdown-safe plain text
  type          String    @default("info") // info | warning | maintenance | feature
  targetPlans   String[]  @default([]) // [] = all plans; ["STARTER","PROFESSIONAL"] = only those
  isDismissible Boolean   @default(true)
  startsAt      DateTime  @default(now())
  endsAt        DateTime? // null = indefinite
  isActive      Boolean   @default(true)
  createdBy     String // admin email
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("platform_announcements")
}

// ─── Demo Leads ───────────────────────────────────────────────────────────────
// Marketing record of who viewed the /try demo — not an auth record. The demo
// session itself still uses the existing seeded `demo` tenant users, unchanged.

model DemoLead {
  id        String   @id @default(cuid())
  email     String
  role      String // matches the /try persona key (OWNER, MANAGER, ...)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("demo_leads")
}

// ─── Feature Flags ────────────────────────────────────────────────────────────

model TenantFeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  flag      String // e.g. "beta_analytics", "ai_suggestions"
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String? // admin email who last toggled

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flag])
  @@index([tenantId])
  @@index([flag])
  @@map("tenant_feature_flags")
}

// A promotion can be redeemed once per tenant. The normalized business fields
// support a lightweight, human-reviewable duplicate check without collecting
// identity documents or blocking a legitimate owner from opening an account.
model PromotionRedemption {
  id                     String   @id @default(cuid())
  promotionKey           String
  tenantId               String   @unique
  normalizedBusinessName String
  normalizedAddress      String?
  redeemedAt             DateTime @default(now())
  expiresAt              DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([promotionKey, normalizedBusinessName])
  @@index([promotionKey, normalizedAddress])
  @@map("promotion_redemptions")
}

// ─── SLA Agreements ───────────────────────────────────────────────────────────

model SlaAgreement {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  tier          SlaTier   @default(BASIC)
  uptimePercent Float     @default(99.0) // e.g. 99.9
  responseTimeH Int       @default(24) // response SLA in hours
  contractStart DateTime
  contractEnd   DateTime? // null = open-ended
  autoRenew     Boolean   @default(true)
  notes         String? // internal admin notes
  signedBy      String? // tenant owner email who accepted
  signedAt      DateTime?
  createdBy     String // admin email
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@map("sla_agreements")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(VIEWER)
  firstName    String    @default("")
  lastName     String    @default("")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  invitedBy    String? // email of admin who created this account
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

// ─── External Calendar Sync ───────────────────────────────────────────────────

model ExternalCalendar {
  id         String    @id @default(cuid())
  tenantId   String
  roomId     String
  name       String // "Booking.com", "Airbnb", etc. (staff sets this)
  icalUrl    String // the iCal URL pasted by staff
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  lastError  String? // null = last sync ok; otherwise error message
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
  @@map("external_calendars")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  date        DateTime        @db.Date
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  vendor      String?
  paymentMode String? // CASH | BANK | CARD | OTHER
  notes       String?
  createdBy   String // user id
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, category])
  @@map("expenses")
}

// ─── Referrals ────────────────────────────────────────────────────────────────

model Referral {
  id         String @id @default(cuid())
  referrerId String // tenant who referred
  referredId String @unique // tenant who signed up (one referral entry per new tenant)
  referrer   Tenant @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   Tenant @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)

  status       String    @default("PENDING") // PENDING | REWARDED | NO_REWARD
  rewardType   String? // CREDIT | FREE_PLAN | NONE
  rewardAmount Float? // ৳ credit amount
  rewardPlan   String? // "PROFESSIONAL"
  rewardMonths Int? // 2
  rewardNote   String?
  rewardedAt   DateTime?
  rewardedBy   String? // admin user email

  createdAt DateTime @default(now())

  @@map("referrals")
}

// ─── Discovery Click Tracking ─────────────────────────────────────────────────

model DiscoveryClick {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // "map_pin" | "list_card" | "affiliate" | "whatsapp" | "profile_view"
  source    String? // "map" | "list" | "blog" | "direct"
  country   String? // visitor country (from CF-IPCountry or IP)
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("discovery_clicks")
}

// ─── Themes ───────────────────────────────────────────────────────────────────

enum ThemeType {
  HARDCODED // built-in themes (luxe, minimal, coastal) — rendered by React component
  UPLOADED // admin uploaded a config JSON/ZIP package
  AI_GENERATED // generated via Claude/GPT API
  TEMPLATE // Tier 2 — designer/Claude-authored HTML+CSS, see plan/theme-contract.md
}

enum ThemeStatus {
  DRAFT // saved, not visible to tenants
  PREVIEW // previewable by admin only
  PUBLISHED // live — tenants can select it
}

/// Resort Owner submits a request to permanently delete their own tenant;
/// Super Admin reviews and approves (triggers the real hard delete via the
/// same code path as an admin-initiated delete) or rejects it. Owners never
/// delete their own tenant directly — see DELETE /api/admin/tenants/:id.
enum TenantDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TenantDeletionRequest {
  id       String @id @default(uuid())
  tenantId String

  requestedById String
  reason        String

  status               TenantDeletionRequestStatus @default(PENDING)
  resolvedAt            DateTime?
  resolvedByAdminEmail  String?
  adminNotes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("TenantDeletionRequests", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tenant_deletion_requests")
}

/// Paid custom-design service — see plan/theme-studio-and-design-service.md.
/// An owner asks for a bespoke website from the dashboard; admin quotes it,
/// builds it, and ships it as a theme scoped to that tenant only.
enum DesignRequestStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

model DesignRequest {
  id       String @id @default(uuid())
  tenantId String // required — tenantPrisma injects and filters on this

  contactName  String
  contactPhone String
  contactEmail String

  /// What they asked for
  tier          String? // "branding" | "custom" | "premium" — the pricing tier they picked
  budgetRange   String?
  timeline      String?
  description   String
  referenceUrls String[] @default([])

  /// Pipeline
  status       DesignRequestStatus @default(NEW)
  quotedAmount Float?
  currency     String?
  quotedAt     DateTime?
  adminNotes   String?

  /// Set once the bespoke theme is built — pairs with Theme.exclusiveToTenantId
  deliveredThemeKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("design_requests")
}

model Theme {
  id           String   @id @default(uuid())
  key          String   @unique // "luxe", "minimal", "coastal", "mountain-escape"
  name         String // "Luxe Gold"
  description  String?
  previewImage String?
  screenshots  String[] @default([]) // additional preview images
  author       String   @default("ResortPro Team")
  version      String   @default("1.0.0")
  tags         String[] @default([]) // ["Luxury", "Gold Accents"]
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  isPremium    Boolean  @default(false)
  requiredPlan String   @default("STARTER") // STARTER | PROFESSIONAL | ENTERPRISE
  sortOrder    Int      @default(0)

  // Dynamic theme fields (Option A & B)
  themeType   ThemeType   @default(HARDCODED)
  themeStatus ThemeStatus @default(PUBLISHED) // HARDCODED themes default to PUBLISHED
  configJson  Json? // ThemeConfig JSON — only for UPLOADED and AI_GENERATED
  aiPrompt    String? // original prompt used for AI generation
  aiProvider  String? // "claude", "gpt-4", etc.
  uploadedBy  String? // super admin user id who uploaded/generated

  // Tier 2 (TEMPLATE) fields — see plan/theme-contract.md
  templateHtml    String? // Handlebars HTML, <style> stripped out at upload
  templateCss     String? // CSS extracted from the uploaded <style> block
  contractVersion String? // which theme-contract.md version this was authored against

  // Bespoke themes: a theme built and paid for by one tenant must not be
  // offered to every other tenant. Null = available to everyone (the default,
  // and how all existing themes behave).
  exclusiveToTenantId String?
  exclusiveToTenant   Tenant? @relation(fields: [exclusiveToTenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([exclusiveToTenantId])
  @@map("themes")
}

// ─── SMS & WhatsApp Marketing ─────────────────────────────────────────────────

model MarketingCampaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  channel String // "sms" | "whatsapp" | "both"
  status  String @default("draft") // draft | scheduled | sending | sent | failed | cancelled

  // Audience
  audienceType   String @default("all") // all | past | upcoming | date_range | vip | custom
  audienceFilter Json? // { dateFrom, dateTo, minStays, tags[] }
  recipientCount Int    @default(0)

  // Message
  message    String
  templateId String?

  // Schedule
  scheduledAt DateTime?
  sentAt      DateTime?

  // Stats
  deliveredCount Int @default(0)
  failedCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs CampaignLog[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("marketing_campaigns")
}

model CampaignLog {
  id         String            @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  guestId   String?
  guestName String?
  phone     String
  channel   String // "sms" | "whatsapp"
  status    String    @default("queued") // queued | sent | delivered | failed
  errorMsg  String?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([campaignId, status])
  @@map("campaign_logs")
}

model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  channel    String // "sms" | "whatsapp" | "both"
  message    String
  usageCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, channel])
  @@map("message_templates")
}

model CampaignLink {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "RAKIB2024" — used in ?ref=CODE
  label     String // e.g. "Rakib - BD Sales"
  createdBy String // admin email who created this
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("campaign_links")
}

// ─── Shareholder Portal (see plan/shareholder-portal.md) ──────────────────────
model ShareholderProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ownershipPercent Float // 0–100
  investedAmount   Float? // optional reference — how much they invested
  joinedAt         DateTime @default(now())
  notes            String? // owner-only internal note

  payouts Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("shareholder_profiles")
}

model Payout {
  id                   String             @id @default(uuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shareholderProfileId String
  shareholderProfile   ShareholderProfile @relation(fields: [shareholderProfileId], references: [id], onDelete: Cascade)

  amount     Float
  method     String // BANK_TRANSFER | BKASH | CASH | OTHER
  paidAt     DateTime
  note       String?
  recordedBy String // owner's User id

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([shareholderProfileId])
  @@map("payouts")
}

model InvestorReport {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month    String // "2026-06"

  netProfit     Float
  occupancyRate Float
  ownerNote     String? // context note owner adds before sending

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, month])
  @@index([tenantId])
  @@map("investor_reports")
}

// ─── Event & Venue Management (see plan/event-venue.md) ───────────────────────
enum VenueType {
  INDOOR
  OUTDOOR
  BOTH
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  SOCIAL
  OTHER
}

enum VenueBookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

model Venue {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  type        VenueType @default(INDOOR)
  capacity    Int
  description String?
  photos      String[]
  videos      String[] @default([])
  amenities   String[]

  halfDayRate  Float?
  fullDayRate  Float?
  hourlyRate   Float?
  overtimeRate Float?

  opensAt       String  @default("08:00")
  closesAt      String  @default("22:00")
  minAdvanceHrs Int     @default(24)
  isVisible     Boolean @default(true)
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  bookings VenueBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("venues")
}

model VenueBooking {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  clientName  String
  clientPhone String
  clientEmail String?
  eventType   EventType @default(OTHER)

  date       DateTime @db.Date
  startTime  String // "09:00"
  endTime    String // "17:00"
  guestCount Int

  baseAmount   Float
  addonsAmount Float   @default(0)
  totalAmount  Float
  paidAmount   Float   @default(0)
  addons       Json? // { catering: 8000, decoration: 5000 }
  notes        String?

  status    VenueBookingStatus @default(CONFIRMED)
  createdBy String // user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([venueId, date])
  @@map("venue_bookings")
}

// ─── Vehicle Rental (see plan/vehicle-rental.md) ──────────────────────────────

enum VehicleType {
  CAR
  BIKE
  SCOOTY
  BICYCLE
  VAN
  OTHER
}

enum VehicleAvailability {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum RentalStatus {
  RESERVED
  OUT
  RETURNED
  CANCELLED
}

model Vehicle {
  id                 String              @id @default(uuid())
  tenantId           String
  type               VehicleType         @default(CAR)
  name               String
  registrationNumber String?
  capacity           Int?
  hourlyRate         Float?
  dailyRate          Float?
  depositAmount      Float?
  availability       VehicleAvailability @default(AVAILABLE)
  notes              String?
  photos             String[]            @default([])
  videos             String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentals VehicleRental[]

  @@index([tenantId])
  @@map("vehicles")
}

model VehicleRental {
  id                String       @id @default(uuid())
  tenantId          String
  vehicleId         String
  guestId           String?
  bookingId         String?
  guestName         String
  guestPhone        String?
  startAt           DateTime
  endAt             DateTime
  actualReturnAt    DateTime?
  status            RentalStatus @default(RESERVED)
  rate              Float
  totalAmount       Float?
  depositCollected  Float?
  depositReturned   Float?
  odometerOut       Int?
  odometerIn        Int?
  fuelOut           String?
  fuelIn            String?
  conditionNotesOut String?
  conditionNotesIn  String?
  billed            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  guest   Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_rentals")
}

// ─── Corporate Accounts (see plan/corporate-accounts.md) ──────────────────────
model CorporateAccount {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyName    String
  billingAddress String?
  taxId          String?
  contactName    String
  contactEmail   String
  contactPhone   String

  paymentTermDays Int    @default(30)
  discountPercent Float  @default(0)
  creditLimit     Float?

  isActive Boolean @default(true)
  notes    String?

  bookings Booking[]
  invoices CorporateInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("corporate_accounts")
}

model CorporateInvoice {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  invoiceNumber String    @unique // "CORP-2026-0001"
  bookings      Booking[]

  subtotal       Float
  discountAmount Float @default(0)
  totalAmount    Float
  paidAmount     Float @default(0)

  status  String    @default("DRAFT") // DRAFT | SENT | PARTIAL | PAID | OVERDUE
  dueDate DateTime
  sentAt  DateTime?
  paidAt  DateTime?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("corporate_invoices")
}
