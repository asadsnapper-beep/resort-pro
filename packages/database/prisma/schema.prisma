generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  OWNER        // সব কিছু দেখতে ও করতে পারে
  MANAGER      // সব কিছু দেখতে ও করতে পারে
  PARTNER      // শুধু Analytics ও Dashboard stats
  RECEPTIONIST // Bookings, Calendar, Rooms, Guests, Housekeeping, Support
  MARKETER     // Analytics, Website, CRM & Email, Guests
  DEVELOPER    // Settings (Embed), Website
  STAFF        // Housekeeping, Maintenance, Restaurant, Orders
  GUEST        // (external, not dashboard user)
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  VILLA
  COTTAGE
  BUNGALOW
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  CONFLICT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  STRIPE
  OTHER
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum HousekeepingType {
  DAILY
  DEEP_CLEAN
  TURNDOWN
  CHECKOUT
  CHECKIN
}

enum StaffDepartment {
  FRONT_DESK
  HOUSEKEEPING
  RESTAURANT
  MAINTENANCE
  SECURITY
  MANAGEMENT
}

enum MenuItemCategory {
  BREAKFAST
  LUNCH
  DINNER
  APPETIZER
  DESSERT
  BEVERAGE
  SPECIAL
}

enum ExpenseCategory {
  SALARIES
  UTILITIES
  MAINTENANCE
  CLEANING
  FOOD_BEVERAGE
  SUPPLIES
  MARKETING
  INSURANCE
  RENT
  EQUIPMENT
  TRANSPORTATION
  OTHER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum InventoryCategory {
  LINEN
  TOILETRIES
  CLEANING
  FOOD_BEVERAGE
  MAINTENANCE
  OFFICE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  MAINTENANCE
  HOUSEKEEPING
  FOOD_BEVERAGE
  BILLING
  COMPLAINT
  REQUEST
  OTHER
}

enum ChatSenderType {
  GUEST
  STAFF
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
  VIEWER
}

enum SlaTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum AmenityCategory {
  POOL
  SPA
  GYM
  BEACH
  SPORTS
  ENTERTAINMENT
  TRANSPORT
  OTHER
}

enum MaintenancePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenanceIssueType {
  AC
  PLUMBING
  ELECTRICAL
  FURNITURE
  DOOR
  WIFI
  TV
  OTHER
}

enum RatePlanType {
  STANDARD
  SEASONAL
  WEEKEND
  PROMO
  EARLY_BIRD
  LAST_MINUTE
}

enum PackagePriceType {
  PER_STAY
  PER_NIGHT
}

enum GroupBookingStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum GroupEventType {
  WEDDING
  CORPORATE
  CONFERENCE
  SPORTS
  TOUR
  FAMILY
  OTHER
}

enum GroupDiscountType {
  NONE
  PERCENTAGE
  FLAT
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  plan        TenantPlan @default(FREE)
  isActive    Boolean    @default(true)
  logoUrl     String?
  address     String?
  phone       String?
  email       String?
  website          String?
  customDomain            String?   @unique  // e.g. www.sunsetresort.com
  domainVerified          Boolean   @default(false)
  domainVerifiedAt        DateTime?
  domainVerificationToken String?             // TXT token for ownership proof
  sslStatus               String?   @default("none")  // none | pending | provisioning | active | error
  sslProvisionedAt        DateTime?
  sslExpiresAt            DateTime?
  sslError                String?             // last error message from cert provisioner
  currency    String     @default("USD")
  taxRate     Float      @default(0)       // invoice tax percentage e.g. 10 = 10%
  timezone    String     @default("UTC")
  checkInTime String     @default("14:00")
  checkOutTime String    @default("11:00")
  // Stripe billing
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  planStatus           String   @default("trialing")  // trialing | active | past_due | canceled | incomplete
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  billingEmail         String?
  // Referral
  referralCode  String?   @unique  // this tenant's shareable code e.g. "SUNSET-A3K9"
  referredById  String?            // which tenant referred this one
  referrer      Tenant?   @relation("TenantReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     Tenant[]  @relation("TenantReferrals")
  // GDPR
  gdprErasureRequestedAt DateTime?  // when tenant/admin requested erasure
  gdprErasureRequestedBy String?    // "owner" | admin email
  gdprAnonymizedAt       DateTime?  // when anonymization was completed
  deletedAt              DateTime?  // soft-delete timestamp (hard purge after 30d)
  // Payment gateways (owner configures in dashboard)
  bkashEnabled     Boolean  @default(false)
  bkashAppKey      String?
  bkashAppSecret   String?
  bkashUsername    String?
  bkashPassword    String?
  sslEnabled       Boolean  @default(false)
  sslStoreId       String?
  sslStorePassword String?
  sslIsLive        Boolean  @default(false)
  stripeGuestEnabled Boolean @default(false)
  // White-label branding
  whitelabelEnabled    Boolean  @default(false)
  brandLogoUrl         String?                  // overrides logoUrl in tenant dashboard header
  brandPrimaryColor    String?                  // hex e.g. "#1a6b5e"
  brandAccentColor     String?                  // hex e.g. "#d4a853"
  companyDisplayName   String?                  // replaces "ResortPro" in UI
  // SSO
  ssoEnabled           Boolean  @default(false)
  ssoProvider          String?                  // "google" | "microsoft" | "okta" | "saml"
  ssoClientId          String?
  ssoClientSecret      String?                  // stored encrypted in production; plain for dev
  ssoConfig            Json?                    // provider-specific extras (tenant_id, domain, etc.)
  // Enterprise onboarding
  onboardingStep        Int      @default(0)    // 0-6; 6 = complete
  onboardingCompletedAt DateTime?
  enterpriseNotes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  users            User[]
  rooms            Room[]
  guests           Guest[]
  bookings         Booking[]
  staff            Staff[]
  housekeepingTasks HousekeepingTask[]
  menuItems        MenuItem[]
  foodOrders       FoodOrder[]
  inventoryItems   InventoryItem[]
  inventoryMovements InventoryMovement[]
  supportTickets   SupportTicket[]
  amenities        Amenity[]
  websiteContent   WebsiteContent?
  notifications    Notification[]
  payments         Payment[]
  // CRM
  guestTags        GuestTag[]
  guestScores      GuestScore[]
  emailConsents    EmailConsent[]
  guestActivities  GuestActivity[]
  emailTemplates   EmailTemplate[]
  campaigns        Campaign[]
  emailSends       EmailSend[]
  sequences        Sequence[]
  sequenceEnrollments SequenceEnrollment[]
  staffInvites     StaffInvite[]
  featureFlags     TenantFeatureFlag[]
  slaAgreement     SlaAgreement?
  invoiceExtras        InvoiceExtra[]
  ratePlans            RatePlan[]
  emailSettings        EmailSettings?
  maintenanceTickets   MaintenanceTicket[]
  packages             Package[]
  groupBookings        GroupBooking[]
  loyaltyProgram       LoyaltyProgram?
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyTransactions  LoyaltyTransaction[]
  externalCalendars    ExternalCalendar[]
  expenses             Expense[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(STAFF)
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff             Staff?
  assignedTickets   SupportTicket[]   @relation("AssignedTickets")
  chatMessages      ChatMessage[]
  notifications     Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model StaffInvite {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  role      UserRole @default(STAFF)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("staff_invites")
}

// ─── Resort ───────────────────────────────────────────────────────────────────

model Room {
  id           String     @id @default(uuid())
  tenantId     String
  number       String
  name         String
  type         RoomType   @default(STANDARD)
  status       RoomStatus @default(AVAILABLE)
  floor        Int?
  maxOccupancy Int        @default(2)
  basePrice    Decimal    @db.Decimal(10, 2)
  description  String?
  amenities    String[]
  images       String[]
  videos       String[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings             Booking[]
  housekeepingTasks    HousekeepingTask[]
  ratePlans            RatePlan[]
  maintenanceTickets   MaintenanceTicket[]
  externalCalendars    ExternalCalendar[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@map("rooms")
}

model Amenity {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    AmenityCategory @default(OTHER)
  icon        String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("amenities")
}

// ─── Guests ───────────────────────────────────────────────────────────────────

model Guest {
  id          String   @id @default(uuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String
  phone       String?
  nationality String?
  idType      String?
  idNumber    String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  foodOrders     FoodOrder[]
  supportTickets SupportTicket[]
  tags           GuestTagRelation[]
  score          GuestScore?
  consent        EmailConsent?
  activities     GuestActivity[]
  emailSends     EmailSend[]
  enrollments    SequenceEnrollment[]
  loyaltyAccount LoyaltyAccount?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("guests")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  roomId          String
  guestId         String
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  adults          Int           @default(1)
  children        Int           @default(0)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  specialRequests String?
  notes           String?
  source          String        @default("DIRECT")
  confirmationNo  String        @unique
  actualCheckIn   DateTime?     // set when staff clicks Check In
  actualCheckOut  DateTime?     // set when staff clicks Check Out
  // Invoice
  invoiceNumber   String?       @unique
  invoiceSentAt   DateTime?
  // Loyalty
  loyaltyPointsAwarded Boolean @default(false)
  // Group booking
  groupId         String?
  // Stripe guest payment
  stripePaymentIntentId String?
  stripePaymentLinkId   String?
  paymentLinkUrl        String?
  // Online payment (guest-facing)
  paymentGateway   String?       // "BKASH" | "SSL" | "STRIPE" | "MANUAL"
  gatewayTxId      String?       // final transaction ID (bkash trxID / ssl valId / stripe PI id)
  gatewayPaymentId String?       // intermediate ID (bkash paymentID / ssl tran_id)
  paidAt           DateTime?     // when payment was confirmed
  // External calendar sync
  externalUid    String?       // iCal VEVENT UID — for duplicate detection
  externalSource String?       // "BOOKING_COM" | "AIRBNB" | "ICAL" etc.
  conflictNote   String?       // set when status = CONFLICT
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room           Room            @relation(fields: [roomId], references: [id])
  guest          Guest           @relation(fields: [guestId], references: [id])
  group          GroupBooking?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payments       Payment[]
  foodOrders     FoodOrder[]
  supportTickets SupportTicket[]
  invoiceExtras  InvoiceExtra[]
  bookingPackages BookingPackage[]

  @@index([tenantId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  bookingId     String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  reference     String?
  stripeId      String?
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@map("payments")
}

model InvoiceExtra {
  id          String   @id @default(cuid())
  tenantId    String
  bookingId   String
  description String
  amount      Float
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("invoice_extras")
}

model MaintenanceTicket {
  id          String               @id @default(cuid())
  tenantId    String
  roomId      String
  issueType   MaintenanceIssueType
  description String
  priority    MaintenancePriority  @default(NORMAL)
  status      MaintenanceStatus    @default(OPEN)
  assignedTo  String?
  resolvedAt  DateTime?
  notes       String?
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([roomId])
  @@map("maintenance_tickets")
}

model RatePlan {
  id          String       @id @default(cuid())
  tenantId    String
  roomId      String?      // null = applies to all rooms
  name        String
  type        RatePlanType @default(STANDARD)
  price       Float
  startDate   DateTime?
  endDate     DateTime?
  daysOfWeek  Int[]        // 0=Sun … 6=Sat; empty = every day
  minNights   Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
  @@map("rate_plans")
}

model EmailSettings {
  id                  String  @id @default(cuid())
  tenantId            String  @unique
  sendConfirmation    Boolean @default(true)
  sendPreArrival      Boolean @default(true)
  sendCheckoutInvoice Boolean @default(true)
  sendCancellation    Boolean @default(true)
  replyToEmail        String?
  footerText          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

model Package {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Float
  priceType   PackagePriceType @default(PER_STAY)
  inclusions  String[]
  imageUrl    String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings BookingPackage[]

  @@index([tenantId])
  @@map("packages")
}

model BookingPackage {
  id        String   @id @default(cuid())
  bookingId String
  packageId String
  packageName String
  price     Float
  priceType PackagePriceType @default(PER_STAY)
  nights    Int      @default(1)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([bookingId, packageId])
  @@index([bookingId])
  @@map("booking_packages")
}

model GroupBooking {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  organization    String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  eventType       GroupEventType      @default(OTHER)
  status          GroupBookingStatus  @default(TENTATIVE)
  checkIn         DateTime            @db.Date
  checkOut        DateTime            @db.Date
  discountType    GroupDiscountType   @default(NONE)
  discountValue   Float               @default(0)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([status])
  @@map("group_bookings")
}

model LoyaltyProgram {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  isEnabled          Boolean @default(false)
  pointsPerDollar    Float   @default(10)    // pts earned per $1 spent
  redemptionRate     Float   @default(100)   // pts required per $1 discount
  bronzeThreshold    Int     @default(0)
  silverThreshold    Int     @default(500)
  goldThreshold      Int     @default(2000)
  platinumThreshold  Int     @default(5000)
  programName        String  @default("Resort Rewards")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id             String      @id @default(cuid())
  tenantId       String
  guestId        String      @unique
  points         Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  joinedAt       DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest        Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([tenantId, guestId])
  @@index([tenantId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String        @id @default(cuid())
  tenantId    String
  accountId   String
  type        LoyaltyTxType
  points      Int
  description String
  bookingId   String?
  createdAt   DateTime      @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountId])
  @@map("loyalty_transactions")
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id         String          @id @default(uuid())
  tenantId   String
  userId     String          @unique
  department StaffDepartment @default(FRONT_DESK)
  position   String
  phone      String?
  hireDate   DateTime        @db.Date
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  housekeepingTasks HousekeepingTask[]

  @@index([tenantId])
  @@map("staff")
}

// ─── Housekeeping ─────────────────────────────────────────────────────────────

model HousekeepingTask {
  id            String             @id @default(uuid())
  tenantId      String
  roomId        String
  assignedToId  String?
  type          HousekeepingType   @default(DAILY)
  status        HousekeepingStatus @default(PENDING)
  scheduledDate DateTime           @db.Date
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room       Room   @relation(fields: [roomId], references: [id])
  assignedTo Staff? @relation(fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([scheduledDate])
  @@index([status])
  @@map("housekeeping_tasks")
}

// ─── Restaurant / F&B ────────────────────────────────────────────────────────

model MenuItem {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    MenuItemCategory @default(SPECIAL)
  price       Decimal          @db.Decimal(10, 2)
  isAvailable Boolean          @default(true)
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems FoodOrderItem[]

  @@index([tenantId])
  @@map("menu_items")
}

model FoodOrder {
  id          String      @id @default(uuid())
  tenantId    String
  bookingId   String?
  guestId     String?
  tableNumber String?
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [bookingId], references: [id])
  guest   Guest?          @relation(fields: [guestId], references: [id])
  items   FoodOrderItem[]

  @@index([tenantId])
  @@index([status])
  @@map("food_orders")
}

model FoodOrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  notes      String?

  order    FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])

  @@map("food_order_items")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  category     InventoryCategory @default(OTHER)
  unit         String
  currentStock Decimal           @db.Decimal(10, 2)
  minimumStock Decimal           @db.Decimal(10, 2)
  unitCost     Decimal           @db.Decimal(10, 2)
  supplier     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([tenantId])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String   @id @default(uuid())
  tenantId        String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(10, 2)
  type            String   // IN | OUT | ADJUSTMENT
  reason          String?
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("inventory_movements")
}

// ─── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id           String          @id @default(uuid())
  tenantId     String
  guestId      String?
  assignedToId String?
  bookingId    String?
  title        String
  description  String
  category     TicketCategory  @default(OTHER)
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest       Guest?        @relation(fields: [guestId], references: [id])
  assignedTo  User?         @relation("AssignedTickets", fields: [assignedToId], references: [id])
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  messages    ChatMessage[]

  @@index([tenantId])
  @@index([status])
  @@map("support_tickets")
}

model ChatMessage {
  id         String         @id @default(uuid())
  ticketId   String
  senderId   String
  senderType ChatSenderType
  message    String
  isRead     Boolean        @default(false)
  createdAt  DateTime       @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("chat_messages")
}

// ─── Website ──────────────────────────────────────────────────────────────────

model WebsiteContent {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  heroTitle     String
  heroSubtitle  String?
  heroImage     String?
  aboutTitle    String?
  aboutText     String?
  aboutImage    String?
  galleryImages String[]
  testimonials  Json     @default("[]")
  seoTitle      String?
  seoDescription String?
  primaryColor  String   @default("#1a6b5e")
  accentColor   String   @default("#d4a853")
  templateId    String   @default("luxe")
  // Social media links
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  tiktokUrl      String?
  youtubeUrl     String?
  whatsappNumber String?  // phone number only e.g. "+8801XXXXXXXXX"
  tripadvisorUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("website_content")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

enum GuestTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum EmailSendStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SequenceTrigger {
  BOOKING_CONFIRMED
  PRE_ARRIVAL
  CHECK_IN
  POST_STAY
  WIN_BACK
  BIRTHDAY
  MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  UNSUBSCRIBED
}

enum ActivityType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  CHECK_IN
  CHECK_OUT
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  FOOD_ORDER
  SUPPORT_TICKET
  FEEDBACK_SUBMITTED
}

// Guest tags (e.g. "VIP", "Honeymoon", "Corporate")
model GuestTag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relations GuestTagRelation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("guest_tags")
}

model GuestTagRelation {
  id        String   @id @default(uuid())
  guestId   String
  tagId     String
  createdAt DateTime @default(now())

  guest Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tag   GuestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([guestId, tagId])
  @@map("guest_tag_relations")
}

// Guest loyalty score + tier
model GuestScore {
  id           String    @id @default(uuid())
  tenantId     String
  guestId      String    @unique
  score        Int       @default(0)
  tier         GuestTier @default(STANDARD)
  totalStays   Int       @default(0)
  totalSpend   Decimal   @default(0) @db.Decimal(12, 2)
  emailOpens   Int       @default(0)
  emailClicks  Int       @default(0)
  lastStayAt   DateTime?
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([score])
  @@map("guest_scores")
}

// Email consent / unsubscribe
model EmailConsent {
  id           String   @id @default(uuid())
  tenantId     String
  guestId      String   @unique
  subscribed   Boolean  @default(true)
  unsubscribedAt DateTime?
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_consents")
}

// Activity log for guests
model GuestActivity {
  id        String       @id @default(uuid())
  tenantId  String
  guestId   String
  type      ActivityType
  meta      Json?
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([guestId])
  @@map("guest_activities")
}

// Reusable email templates with HTML content
model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  subject   String
  html      String
  preheader String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  steps     SequenceStep[]

  @@index([tenantId])
  @@map("email_templates")
}

// Broadcast campaigns (one-time email blasts)
model Campaign {
  id           String         @id @default(uuid())
  tenantId     String
  templateId   String?
  name         String
  subject      String
  html         String
  segment      Json?          // filter criteria (tier, tags, lastStayBefore, etc.)
  status       CampaignStatus @default(DRAFT)
  scheduledAt  DateTime?
  sentAt       DateTime?
  recipientCount Int          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template EmailTemplate?  @relation(fields: [templateId], references: [id])
  sends    EmailSend[]
  stats    CampaignStats?

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

// Aggregate stats per campaign
model CampaignStats {
  id          String   @id @default(uuid())
  campaignId  String   @unique
  sent        Int      @default(0)
  delivered   Int      @default(0)
  opened      Int      @default(0)
  clicked     Int      @default(0)
  bounced     Int      @default(0)
  unsubscribed Int     @default(0)
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_stats")
}

// Individual email send record (per guest per campaign/sequence)
model EmailSend {
  id           String          @id @default(uuid())
  tenantId     String
  guestId      String
  campaignId   String?
  sequenceStepId String?
  enrollmentId String?
  subject      String
  status       EmailSendStatus @default(PENDING)
  resendId     String?         // Resend message ID
  openedAt     DateTime?
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  sequenceStep SequenceStep? @relation(fields: [sequenceStepId], references: [id])
  clicks       EmailClick[]

  @@index([tenantId])
  @@index([guestId])
  @@index([campaignId])
  @@map("email_sends")
}

// Link click tracking
model EmailClick {
  id         String   @id @default(uuid())
  sendId     String
  url        String
  clickedAt  DateTime @default(now())

  send EmailSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@index([sendId])
  @@map("email_clicks")
}

// ─── Stripe ───────────────────────────────────────────────────────────────────

model StripeWebhookEvent {
  id        String   @id @default(uuid())
  stripeId  String   @unique
  type      String
  processed Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())

  @@index([type])
  @@map("stripe_webhook_events")
}

// Singleton platform-level settings (one row)
model PlatformSettings {
  id            String   @id @default("singleton")
  trialDays     Int      @default(14)
  plans         Json     // Array of { key, name, price, features, roomLimit }
  storageConfig Json?    // { driver, endpoint, region, bucket, publicUrl, accessKey, secretKey }
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

// Automated email sequences (drip campaigns)
model Sequence {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  trigger     SequenceTrigger
  triggerMeta Json?           // e.g. { daysOffset: -3 } for pre-arrival
  status      SequenceStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@index([trigger])
  @@map("sequences")
}

// Individual steps inside a sequence (each = one email)
model SequenceStep {
  id           String   @id @default(uuid())
  sequenceId   String
  templateId   String?
  stepOrder    Int
  delayDays    Int      @default(0)   // days after trigger
  subject      String
  html         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sequence  Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template  EmailTemplate? @relation(fields: [templateId], references: [id])
  sends     EmailSend[]

  @@index([sequenceId])
  @@map("sequence_steps")
}

// Tracks which guests are enrolled in which sequences
model SequenceEnrollment {
  id          String           @id @default(uuid())
  tenantId    String
  sequenceId  String
  guestId     String
  status      EnrollmentStatus @default(ACTIVE)
  currentStep Int              @default(0)
  triggerMeta Json?            // context at time of enrollment (bookingId, checkIn, etc.)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, guestId])
  @@index([tenantId])
  @@index([status])
  @@map("sequence_enrollments")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── Admin Notifications ──────────────────────────────────────────────────────

model AdminNotification {
  id         String   @id @default(cuid())
  type       String   // new_signup | payment_failed | subscription_canceled | trial_expiring | account_suspended
  title      String
  message    String
  isRead     Boolean  @default(false)
  metadata   Json?    // { tenantId, tenantName, tenantSlug, plan, amount, ... }
  linkPath   String?  // e.g. "/admin/tenants?id=xxx" — click → navigate here
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // impersonate | suspend | reactivate | plan_change | extend_trial | export | settings_change | theme_update | theme_toggle
  targetType String   // tenant | user | theme | settings
  targetId   String?
  targetName String?  // human-readable label (tenant name, theme key, etc.)
  metadata   Json?    // { before, after } for plan_change; { days } for extend_trial; etc.
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Platform Announcements ───────────────────────────────────────────────────

model PlatformAnnouncement {
  id          String    @id @default(cuid())
  title       String
  body        String    // markdown-safe plain text
  type        String    @default("info")   // info | warning | maintenance | feature
  targetPlans String[]  @default([])       // [] = all plans; ["STARTER","PROFESSIONAL"] = only those
  isDismissible Boolean @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?                    // null = indefinite
  isActive    Boolean   @default(true)
  createdBy   String                       // admin email
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("platform_announcements")
}

// ─── Feature Flags ────────────────────────────────────────────────────────────

model TenantFeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  flag      String   // e.g. "beta_analytics", "ai_suggestions"
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?  // admin email who last toggled

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flag])
  @@index([tenantId])
  @@index([flag])
  @@map("tenant_feature_flags")
}

// ─── SLA Agreements ───────────────────────────────────────────────────────────

model SlaAgreement {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tier           SlaTier   @default(BASIC)
  uptimePercent  Float     @default(99.0)     // e.g. 99.9
  responseTimeH  Int       @default(24)       // response SLA in hours
  contractStart  DateTime
  contractEnd    DateTime?                    // null = open-ended
  autoRenew      Boolean   @default(true)
  notes          String?                      // internal admin notes
  signedBy       String?                      // tenant owner email who accepted
  signedAt       DateTime?
  createdBy      String                       // admin email
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@map("sla_agreements")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(VIEWER)
  firstName    String    @default("")
  lastName     String    @default("")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  invitedBy    String?   // email of admin who created this account
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

// ─── External Calendar Sync ───────────────────────────────────────────────────

model ExternalCalendar {
  id          String   @id @default(cuid())
  tenantId    String
  roomId      String
  name        String   // "Booking.com", "Airbnb", etc. (staff sets this)
  icalUrl     String   // the iCal URL pasted by staff
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  lastError   String?  // null = last sync ok; otherwise error message
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
  @@map("external_calendars")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  date        DateTime        @db.Date
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  vendor      String?
  paymentMode String?         // CASH | BANK | CARD | OTHER
  notes       String?
  createdBy   String          // user id
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, category])
  @@map("expenses")
}

// ─── Themes ───────────────────────────────────────────────────────────────────

model Theme {
  id           String   @id @default(uuid())
  key          String   @unique      // "luxe", "minimal", "coastal"
  name         String                // "Luxe Gold"
  description  String?
  previewImage String?
  author       String   @default("ResortPro Team")
  version      String   @default("1.0.0")
  tags         String[] @default([]) // ["Luxury", "Gold Accents"]
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  isPremium    Boolean  @default(false)
  requiredPlan String   @default("STARTER") // STARTER | PROFESSIONAL | ENTERPRISE
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("themes")
}
