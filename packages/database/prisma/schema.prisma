generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  OWNER // সব কিছু দেখতে ও করতে পারে
  MANAGER // Billing বাদে সব
  SHAREHOLDER // শুধু Dashboard, Analytics, Reports — read-only
  RECEPTIONIST // Bookings, Calendar, Rooms, Guests, Housekeeping, Support
  MARKETER // Analytics, Website, CRM & Email, Guests
  DEVELOPER // Settings (Embed), Website, Channel Sync
  STAFF // Housekeeping, Maintenance, Restaurant, Orders
  CHEF // Kitchen — Food Orders view & status update only
  GUEST // (external, not dashboard user)
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  VILLA
  COTTAGE
  BUNGALOW
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  RESERVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  CONFLICT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PARTIAL
  PAID
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  // Legacy / manual methods
  CASH
  CARD
  BANK_TRANSFER
  OTHER
  // 🇧🇩 Bangladesh
  BKASH
  NAGAD
  SSLCOMMERZ
  ROCKET
  // 🇮🇳 India
  RAZORPAY
  CASHFREE
  // 🇱🇰 Sri Lanka
  PAYHERE
  // 🇳🇵 Nepal
  ESEWA
  KHALTI
  // 🇹🇭 🇮🇩 🇲🇾 SE Asia (Phase 2)
  MIDTRANS
  OMISE
  IPAY88
  // 🇰🇪 Africa (Phase 2)
  MPESA
  FLUTTERWAVE
  PAYSTACK
  // 🌍 Global
  STRIPE
  PAYPAL
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum HousekeepingType {
  DAILY
  DEEP_CLEAN
  TURNDOWN
  CHECKOUT
  CHECKIN
}

enum StaffDepartment {
  FRONT_DESK
  HOUSEKEEPING
  RESTAURANT
  MAINTENANCE
  SECURITY
  MANAGEMENT
}

enum MenuItemCategory {
  BREAKFAST
  LUNCH
  DINNER
  APPETIZER
  DESSERT
  BEVERAGE
  SPECIAL
}

enum ExpenseCategory {
  SALARIES
  UTILITIES
  MAINTENANCE
  CLEANING
  FOOD_BEVERAGE
  SUPPLIES
  MARKETING
  INSURANCE
  RENT
  EQUIPMENT
  TRANSPORTATION
  OTHER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum InventoryCategory {
  LINEN
  TOILETRIES
  CLEANING
  FOOD_BEVERAGE
  MAINTENANCE
  OFFICE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  MAINTENANCE
  HOUSEKEEPING
  FOOD_BEVERAGE
  BILLING
  COMPLAINT
  REQUEST
  OTHER
}

enum ChatSenderType {
  GUEST
  STAFF
  BOT // system-generated / webhook-forwarded messages
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
  VIEWER
}

enum SlaTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum AmenityCategory {
  POOL
  SPA
  GYM
  BEACH
  SPORTS
  ENTERTAINMENT
  TRANSPORT
  OTHER
}

enum MaintenancePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenanceIssueType {
  AC
  PLUMBING
  ELECTRICAL
  FURNITURE
  DOOR
  WIFI
  TV
  OTHER
}

enum RatePlanType {
  STANDARD
  SEASONAL
  WEEKEND
  PROMO
  EARLY_BIRD
  LAST_MINUTE
}

enum PackagePriceType {
  PER_STAY
  PER_NIGHT
}

enum GroupBookingStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum GroupEventType {
  WEDDING
  CORPORATE
  CONFERENCE
  SPORTS
  TOUR
  FAMILY
  OTHER
}

enum GroupDiscountType {
  NONE
  PERCENTAGE
  FLAT
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model Tenant {
  id                      String     @id @default(uuid())
  name                    String
  slug                    String     @unique
  plan                    TenantPlan @default(FREE)
  isActive                Boolean    @default(true)
  isDemo                  Boolean    @default(false) // demo tenant — read-only, auto-login
  logoUrl                 String?
  address                 String?
  phone                   String?
  email                   String?
  website                 String?
  customDomain            String?    @unique // e.g. www.sunsetresort.com
  domainVerified          Boolean    @default(false)
  domainVerifiedAt        DateTime?
  domainVerificationToken String? // TXT token for ownership proof
  sslStatus               String?    @default("none") // none | pending | provisioning | active | error
  sslProvisionedAt        DateTime?
  sslExpiresAt            DateTime?
  sslError                String? // last error message from cert provisioner
  country                 String     @default("BD") // ISO 3166-1 alpha-2: BD, IN, LK, NP, TH, ID, MY, KE...
  currency                String     @default("BDT")
  taxRate                 Float      @default(0) // invoice tax percentage e.g. 10 = 10%
  timezone                String     @default("Asia/Dhaka")
  checkInTime             String     @default("14:00")
  checkOutTime            String     @default("11:00")
  attendanceDeviceKey     String?    @unique // secret for the fingerprint device webhook
  roomTypeLabels          Json? // { "STANDARD": "Garden Room", ... } — display-layer override
  // Stripe billing
  stripeCustomerId        String?    @unique
  stripeSubscriptionId    String?    @unique
  planStatus              String     @default("trialing") // trialing | active | past_due | canceled | incomplete
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  priceProtectedUntil     DateTime? // current plan price remains valid through this date
  billingEmail            String?
  // Referral & marketing attribution
  referralCode            String?    @unique // this tenant's shareable code e.g. "SUNSET-A3K9"
  referredById            String? // which tenant referred this one
  campaignSource          String? // campaign link code used during signup (e.g. "RAKIB2024")
  referrer                Tenant?    @relation("TenantReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               Tenant[]   @relation("TenantReferrals")
  accountCredit           Float      @default(0) // ৳ credit balance — deducted from next invoice
  freeUntil               DateTime? // free plan expiry (set when reward = FREE_PLAN)
  referralsMade           Referral[] @relation("ReferrerReferrals")
  referralEntry           Referral?  @relation("ReferredReferrals")
  promotionRedemptions    PromotionRedemption[]
  // GDPR
  gdprErasureRequestedAt  DateTime? // when tenant/admin requested erasure
  gdprErasureRequestedBy  String? // "owner" | admin email
  gdprAnonymizedAt        DateTime? // when anonymization was completed
  deletedAt               DateTime? // soft-delete timestamp (hard purge after 30d)
  // Payment gateways (owner configures in dashboard)
  bkashEnabled            Boolean    @default(false)
  bkashAppKey             String?
  bkashAppSecret          String?
  bkashUsername           String?
  bkashPassword           String?
  sslEnabled              Boolean    @default(false)
  sslStoreId              String?
  sslStorePassword        String?
  sslIsLive               Boolean    @default(false)
  stripeGuestEnabled      Boolean    @default(false)
  // SMS & WhatsApp notifications
  smsEnabled              Boolean    @default(false)
  smsMode                 String     @default("platform") // "platform" | "own"
  smsProvider             String? // "ssl_wireless" | "twilio" | "alpha_net"
  smsApiKey               String?
  smsApiSecret            String?
  smsSenderId             String?
  waEnabled               Boolean    @default(false)
  waMode                  String     @default("platform") // "platform" | "own"
  waApiToken              String?
  waPhoneNumberId         String?
  waBusinessAccId         String?
  // Telegram support channel
  telegramBotToken        String? // bot token from BotFather
  telegramNotifChatId     String? // staff group/channel chat_id for new ticket alerts
  // Notification triggers
  notifBookingConfirm     Boolean    @default(true)
  notifPaymentReceived    Boolean    @default(true)
  notifCheckinReminder    Boolean    @default(true)
  notifCheckoutRemind     Boolean    @default(false)
  notifCancellation       Boolean    @default(true)
  notifInvoiceSent        Boolean    @default(false)
  notifLanguage           String     @default("en") // "en" | "bn"
  // SMS quota & credits
  smsQuotaMonthly         Int        @default(100)
  smsUsedThisMonth        Int        @default(0)
  smsCredits              Int        @default(0)
  waQuotaMonthly          Int        @default(50)
  waUsedThisMonth         Int        @default(0)
  waCredits               Int        @default(0)
  // White-label branding
  whitelabelEnabled       Boolean    @default(false)
  brandLogoUrl            String? // overrides logoUrl in tenant dashboard header
  brandPrimaryColor       String? // hex e.g. "#1a6b5e"
  brandAccentColor        String? // hex e.g. "#d4a853"
  companyDisplayName      String? // replaces "ResortPro" in UI
  // SSO
  ssoEnabled              Boolean    @default(false)
  ssoProvider             String? // "google" | "microsoft" | "okta" | "saml"
  ssoClientId             String?
  ssoClientSecret         String? // stored encrypted in production; plain for dev
  ssoConfig               Json? // provider-specific extras (tenant_id, domain, etc.)
  // Enterprise onboarding
  onboardingStep          Int        @default(0) // 0-6; 6 = complete
  onboardingCompletedAt   DateTime?
  enterpriseNotes         String?
  // stay.resortpro.site — Public discovery map
  mapVisible              Boolean    @default(false) // show on public map
  latitude                Float? // e.g. 22.3569
  longitude               Float? // e.g. 91.7832
  resortCategory          String? // "eco" | "agro" | "beach" | "hill" | "city" | "heritage"
  priceFrom               Float? // starting price per night (display only)
  shortDescription        String? // 1-2 line blurb for map popup & list card
  coverImageUrl           String? // hero image for resort card on discovery page
  // stay.resortpro.site — Revenue features
  isFeatured              Boolean    @default(false) // sponsored / featured listing
  featuredUntil           DateTime? // expiry of featured status
  featuredBadge           String? // "Sponsored" | "Top Pick" | "Editor's Choice"
  affiliateUrl            String? // booking.com / agoda / direct affiliate link
  affiliateSource         String? // "booking.com" | "agoda" | "direct" | "custom"
  discoveryTier           String     @default("free") // "free" | "basic" | "premium"
  // Gallery (premium feature — up to 6 extra images)
  galleryImages           String[]   @default([])
  // Profile extras (premium)
  amenitiesHighlights     String[]   @default([]) // e.g. ["Pool", "WiFi", "Restaurant"]
  bookingPhone            String? // WhatsApp / call button on discovery page
  instagramHandle         String? // @handle
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  // Relations
  users                  User[]
  properties             Property[]
  rooms                  Room[]
  guests                 Guest[]
  bookings               Booking[]
  staff                  Staff[]
  housekeepingTasks      HousekeepingTask[]
  menuItems              MenuItem[]
  foodOrders             FoodOrder[]
  inventoryItems         InventoryItem[]
  inventoryMovements     InventoryMovement[]
  vendors                Vendor[]
  purchaseOrders         PurchaseOrder[]
  assets                 Asset[]
  lostFoundItems         LostFoundItem[]
  minibarItems           MinibarItem[]
  minibarConsumptions    MinibarConsumption[]
  laundryOrders          LaundryOrder[]
  staffAttendance        StaffAttendance[]
  salaryAdjustments      SalaryAdjustment[]
  trainingSessions       TrainingSession[]
  vehicles               Vehicle[]
  vehicleRentals         VehicleRental[]
  supportTickets         SupportTicket[]
  amenities              Amenity[]
  websiteContent         WebsiteContent?
  websitePageViews       WebsitePageView[]
  reportDispatchSettings ReportDispatchSettings?
  notifications          Notification[]
  payments               Payment[]
  // CRM
  guestTags              GuestTag[]
  guestScores            GuestScore[]
  emailConsents          EmailConsent[]
  guestActivities        GuestActivity[]
  emailTemplates         EmailTemplate[]
  campaigns              Campaign[]
  emailSends             EmailSend[]
  sequences              Sequence[]
  sequenceEnrollments    SequenceEnrollment[]
  staffInvites           StaffInvite[]
  featureFlags           TenantFeatureFlag[]
  slaAgreement           SlaAgreement?
  invoiceExtras          InvoiceExtra[]
  invoices               Invoice[]
  invoicePayments        InvoicePayment[]
  ratePlans              RatePlan[]
  emailSettings          EmailSettings?
  maintenanceTickets     MaintenanceTicket[]
  packages               Package[]
  groupBookings          GroupBooking[]
  loyaltyProgram         LoyaltyProgram?
  loyaltyAccounts        LoyaltyAccount[]
  loyaltyTransactions    LoyaltyTransaction[]
  externalCalendars      ExternalCalendar[]
  expenses               Expense[]
  // SMS & WhatsApp Marketing
  marketingCampaigns     MarketingCampaign[]
  messageTemplates       MessageTemplate[]
  offers                 Offer[]
  paymentConfig          TenantPaymentConfig?
  discoveryClicks        DiscoveryClick[]
  guestDocuments         GuestDocument[]
  restaurantTables       RestaurantTable[]
  // AI (built behind flags — see plan/ai/ROLLOUT-STRATEGY.md)
  aiKeys                 AiKeys?
  aiUsages               AiUsage[]
  generatedContent       GeneratedContent[]
  bookingLeads           BookingLead[]
  guestChatSessions      GuestChatSession[]
  aiAbuseLogs            AiAbuse[]
  revenueSnapshots       RevenueSnapshot[]
  aiInsights             AIInsight[]
  shareholderProfiles    ShareholderProfile[]
  payouts                Payout[]
  investorReports        InvestorReport[]
  venues                 Venue[]
  venueBookings          VenueBooking[]
  corporateAccounts      CorporateAccount[]
  corporateInvoices      CorporateInvoice[]
  designRequests         DesignRequest[]
  exclusiveThemes        Theme[]
  deletionRequests       TenantDeletionRequest[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(STAFF)
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Existing/invited staff are trusted by default. Public resort signup
  // explicitly writes null until the owner clicks the verification link.
  emailVerifiedAt DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff               Staff?
  assignedTickets     SupportTicket[]      @relation("AssignedTickets")
  chatMessages        ChatMessage[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  shareholderProfile  ShareholderProfile?
  tenantDeletionRequests TenantDeletionRequest[] @relation("TenantDeletionRequests")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model StaffInvite {
  id               String   @id @default(uuid())
  tenantId         String
  email            String
  role             UserRole @default(STAFF)
  ownershipPercent Float? // only set when role = SHAREHOLDER
  token            String   @unique
  expiresAt        DateTime
  used             Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("staff_invites")
}

// ─── Resort ───────────────────────────────────────────────────────────────────

enum PropertyType {
  ROOM_BASED
  VESSEL_BASED
}

model Property {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  slug         String // e.g. "beach-villa", "mountain-lodge"
  type         PropertyType @default(ROOM_BASED)
  address      String?
  phone        String?
  email        String?
  timezone     String       @default("Asia/Dhaka")
  checkInTime  String       @default("14:00")
  checkOutTime String       @default("11:00")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms  Room[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("properties")
}

model Room {
  id           String     @id @default(uuid())
  tenantId     String
  propertyId   String?
  number       String
  name         String
  type         RoomType   @default(STANDARD)
  status       RoomStatus @default(AVAILABLE)
  floor        Int?
  maxOccupancy Int        @default(2)
  basePrice    Decimal    @db.Decimal(10, 2)
  description  String?
  amenities    String[]
  images       String[]
  videos       String[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  housekeepingTasks  HousekeepingTask[]
  ratePlans          RatePlan[]
  maintenanceTickets MaintenanceTicket[]
  externalCalendars  ExternalCalendar[]
  assets             Asset[]
  lostFoundItems      LostFoundItem[]
  minibarConsumptions MinibarConsumption[]
  laundryOrders       LaundryOrder[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@index([propertyId])
  @@map("rooms")
}

model Amenity {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    AmenityCategory @default(OTHER)
  icon        String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("amenities")
}

// ─── Guests ───────────────────────────────────────────────────────────────────

model Guest {
  id          String    @id @default(uuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String
  phone       String?
  nationality String?
  idType      String?
  idNumber    String?
  address     String?
  notes       String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  foodOrders     FoodOrder[]
  supportTickets SupportTicket[]
  tags           GuestTagRelation[]
  score          GuestScore?
  consent        EmailConsent?
  activities     GuestActivity[]
  emailSends     EmailSend[]
  enrollments    SequenceEnrollment[]
  loyaltyAccount LoyaltyAccount?
  documents      GuestDocument[]
  vehicleRentals VehicleRental[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("guests")
}

model GuestDocument {
  id         String   @id @default(uuid())
  guestId    String
  tenantId   String
  docType    String // PASSPORT | NATIONAL_ID | DRIVERS_LICENSE | VISA | OTHER
  imageUrl   String
  notes      String?
  uploadedAt DateTime @default(now())
  uploadedBy String? // staff user ID

  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([tenantId])
  @@map("guest_documents")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id                    String        @id @default(uuid())
  tenantId              String
  roomId                String
  guestId               String
  checkIn               DateTime      @db.Date
  checkOut              DateTime      @db.Date
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  adults                Int           @default(1)
  children              Int           @default(0)
  totalAmount           Decimal       @db.Decimal(10, 2)
  paidAmount            Decimal       @default(0) @db.Decimal(10, 2)
  specialRequests       String?
  notes                 String?
  source                String        @default("DIRECT")
  confirmationNo        String        @unique
  actualCheckIn         DateTime? // set when staff clicks Check In
  actualCheckOut        DateTime? // set when staff clicks Check Out
  // Cancellation
  cancellationReason    String? // owner-selected reason (or free text)
  cancellationFee       Decimal?      @db.Decimal(10, 2) // withheld from refund, per resort's own policy
  cancelledAt           DateTime?
  cancelledBy           String? // staff userId who cancelled it
  // Invoice
  invoiceNumber         String?       @unique
  invoiceSentAt         DateTime?
  // Loyalty
  loyaltyPointsAwarded  Boolean       @default(false)
  // Group booking
  groupId               String?
  // Corporate account (bill to company instead of guest)
  corporateAccountId    String?
  corporateInvoiceId    String? // set once included in a generated invoice
  // Stripe guest payment
  stripePaymentIntentId String?
  stripePaymentLinkId   String?
  paymentLinkUrl        String?
  // Online payment (guest-facing)
  paymentGateway        String? // "BKASH" | "SSL" | "STRIPE" | "MANUAL"
  gatewayTxId           String? // final transaction ID (bkash trxID / ssl valId / stripe PI id)
  gatewayPaymentId      String? // intermediate ID (bkash paymentID / ssl tran_id)
  paidAt                DateTime? // when payment was confirmed
  // Front desk
  checkedInBy           String? // staff userId who did check-in
  checkedOutBy          String? // staff userId who did check-out
  roomNotes             String? // front desk notes (key card, deposit note, etc.)
  deposit               Decimal?      @db.Decimal(10, 2) // deposit collected at check-in
  walkIn                Boolean       @default(false) // true = walk-in, no prior booking
  // External calendar sync
  externalUid           String? // iCal VEVENT UID — for duplicate detection
  externalSource        String? // "BOOKING_COM" | "AIRBNB" | "ICAL" etc.
  conflictNote          String? // set when status = CONFLICT
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest            Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  group            GroupBooking?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  corporateInvoice CorporateInvoice? @relation(fields: [corporateInvoiceId], references: [id], onDelete: SetNull)
  payments         Payment[]
  foodOrders       FoodOrder[]
  supportTickets   SupportTicket[]
  invoiceExtras    InvoiceExtra[]
  bookingPackages  BookingPackage[]
  bookingOffers    BookingOffer[]
  invoice          Invoice?
  minibarConsumptions MinibarConsumption[]
  laundryOrders       LaundryOrder[]
  vehicleRentals      VehicleRental[]

  @@index([tenantId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@map("bookings")
}

model Offer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        OfferType
  value       Float // 30 = 30%, 500 = ৳500, 1 = 1 free night
  promoCode   String? // null = auto-apply, no code needed
  minStay     Int       @default(1)

  validFrom DateTime
  validTo   DateTime
  maxUses   Int? // null = unlimited
  usedCount Int      @default(0)

  roomIds     String[] @default([]) // empty = all rooms
  showOnBar   Boolean  @default(true)
  showSection Boolean  @default(true)
  showOnCards Boolean  @default(true)
  priority    Int      @default(0)
  isActive    Boolean  @default(true)

  bookingOffers BookingOffer[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("offers")
}

enum OfferType {
  PERCENTAGE
  FIXED
  FREE_NIGHT
}

model BookingOffer {
  id        String  @id @default(cuid())
  bookingId String
  offerId   String
  discount  Float // actual amount saved
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, offerId])
  @@map("booking_offers")
}

model Payment {
  id        String  @id @default(uuid())
  tenantId  String
  bookingId String? // nullable — advance deposit বা direct payment হতে পারে

  // Amount & currency
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  // Payment method & gateway
  method           PaymentMethod @default(CASH)
  gateway          String? // 'bkash' | 'nagad' | 'sslcommerz' | 'razorpay' | 'stripe' | ...
  gatewayPaymentId String? // gateway-এর নিজস্ব payment ID
  gatewayOrderId   String? // razorpay order_id / stripe payment_intent id
  gatewaySessionId String? // SSLCommerz / bKash session token

  status PaymentStatus @default(PENDING)

  // Payer info
  payerName  String?
  payerEmail String?
  payerPhone String?

  // Legacy / extra fields
  reference   String? // manual reference number
  notes       String?
  metadata    Json? // gateway-specific extra data
  webhookData Json? // raw webhook payload (debugging)

  processedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
  @@index([gateway])
  @@index([status])
  @@index([gatewayPaymentId])
  @@map("payments")
}

// ── Payment Gateway Registry ─────────────────────────────────────────────────
// Tenant-এর payment gateway configuration — credentials encrypted in production

model TenantPaymentConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Active gateway for online checkout
  activeGateway String @default("manual") // 'bkash'|'nagad'|'sslcommerz'|'razorpay'|'payhere'|'esewa'|'khalti'|'stripe'|'manual'

  // Gateway credentials stored as JSON (encrypted in production via AES-256)
  // Shape: { bkash: { appKey, appSecret, username, password }, stripe: { secretKey, publishableKey }, ... }
  credentials Json @default("{}")

  // Which payment methods to show guests on checkout page
  // Values: 'mobile_banking' | 'card' | 'net_banking' | 'wallet' | 'manual'
  enabledMethods String[] @default(["manual"])

  // Manual payment instructions (shown if guest picks "Pay at Resort")
  manualInstructions String?

  // Test/sandbox mode toggle
  testMode Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_payment_configs")
}

model InvoiceExtra {
  id          String   @id @default(cuid())
  tenantId    String
  bookingId   String
  description String
  amount      Float
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("invoice_extras")
}

// ── Invoice System ───────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum InvoiceItemCategory {
  ROOM
  FOOD
  SERVICE
  LAUNDRY
  MINIBAR
  TAX
  DISCOUNT
  OTHER
}

model Invoice {
  id            String  @id @default(uuid())
  invoiceNumber String  @unique // INV-2026-0001 (auto-generated)
  tenantId      String
  bookingId     String? @unique // one invoice per booking

  // Guest info snapshot
  guestName  String
  guestEmail String?
  guestPhone String?

  status InvoiceStatus @default(DRAFT)

  // Financials
  subtotal     Float   @default(0)
  taxRate      Float   @default(0) // percentage e.g. 15 = 15%
  taxAmount    Float   @default(0)
  discountAmt  Float   @default(0)
  discountNote String?
  total        Float   @default(0)

  // Payment tracking
  paidAmount Float     @default(0)
  dueDate    DateTime?
  notes      String?

  // Relations
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments InvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String              @id @default(uuid())
  invoiceId   String
  description String
  category    InvoiceItemCategory @default(OTHER)
  quantity    Float               @default(1)
  unitPrice   Float
  total       Float // quantity × unitPrice (pre-computed)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id        String        @id @default(uuid())
  invoiceId String
  tenantId  String
  amount    Float
  method    PaymentMethod @default(CASH)
  reference String?
  note      String?
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_payments")
}

